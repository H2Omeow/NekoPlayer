# Statically linked WebView2 loader for the embedded dynamic lyrics view.
# tool/prepare_windows.py stages the pinned, checksum-verified NuGet package.
set(NEKO_WINDOWS_WEBVIEW2_DIR "$ENV{NEKO_WINDOWS_WEBVIEW2_DIR}" CACHE PATH "Pinned WebView2 SDK headers and static loader")
set(NEKO_WEBVIEW2_AVAILABLE OFF)
if(NEKO_WINDOWS_WEBVIEW2_DIR)
  get_filename_component(webview2_root "${NEKO_WINDOWS_WEBVIEW2_DIR}" REALPATH)
  foreach(required "include/WebView2.h" "include/WebView2EnvironmentOptions.h" "lib/WebView2LoaderStatic.lib")
    if(NOT EXISTS "${webview2_root}/${required}")
      message(FATAL_ERROR "Missing WebView2 component: ${webview2_root}/${required}")
    endif()
  endforeach()
  set(NEKO_WEBVIEW2_AVAILABLE ON)
  set(NEKO_WEBVIEW2_INCLUDE_DIR "${webview2_root}/include")
  set(NEKO_WEBVIEW2_LIBRARY "${webview2_root}/lib/WebView2LoaderStatic.lib")
  set(NEKO_WEBVIEW2_LICENSE "${webview2_root}/LICENSE.txt")
elseif("$ENV{NEKO_REQUIRE_WEBVIEW2}" STREQUAL "ON")
  message(FATAL_ERROR "NEKO_WINDOWS_WEBVIEW2_DIR is required: run tool/prepare_windows.py runtime")
else()
  message(WARNING "WebView2 SDK not provided; the embedded dynamic lyrics view falls back to the browser.")
endif()
